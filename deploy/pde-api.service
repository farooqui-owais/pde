[Unit]
Description=PDE API (FastAPI + Uvicorn via Gunicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/pde/pde-backend
EnvironmentFile=/opt/pde/pde-backend/.env
ExecStart=/opt/pde/venv/bin/gunicorn app.main:app -w 4 -k uvicorn.workers.UvicornWorker -b 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target