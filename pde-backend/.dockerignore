# pde-backend — Docker build context ignores
# Keeps sensitive + unnecessary files out of the image.

# Secrets — NEVER bake .env into an image
.env
.env.*
!.env.example

# Python caches / virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Docs / git noise
.git/
.gitignore
docker.md
README.md
*.md
