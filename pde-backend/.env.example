# ===== PDE Backend environment template =====
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Mirrors REUSABLE_PROJECT_PROMPT.md §2 / §6.

# Identity / features
APP_NAME=PDE API
APP_VERSION=1.0.0

# Set DEBUG=False in production (disables Swagger /docs, /redoc, /openapi.json).
DEBUG=False

# PostgreSQL DSN (see docker-compose + README)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pde

# === JWT auth (HS256) ===
# MUST be a random string, >= 32 chars. Never reuse the docker-compose value
# in a real deployment. Example generator: secrets.token_urlsafe(64)
SECRET_KEY=change-this-to-a-random-64-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# === CORS ===
# Exact allowlist (no trailing slashes). Must include the deployed frontend
# origin in production. Never use "*" once cookies are involved.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === CSRF (double-submit cookie) ===
# cookie / header names must match the frontend api client.
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
# True in production (cookie is only sent over HTTPS).
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=lax

# === Trusted hosts ===
# "*" disables the check (dev). In production list your public host(s), e.g.
# TRUSTED_HOSTS=api.example.com,localhost
TRUSTED_HOSTS=*

# === Auth rate limiting (per IP, sliding window) ===
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_SECONDS=60