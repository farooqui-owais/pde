# ================================================================
# .gitignore — `prod` branch (AWS Terraform + frontend + backend).
#
# This branch holds only the files the production deployment needs:
#   terraform/        AWS infra (prod environment + modules)
#   pde-backend/      FastAPI app served by gunicorn on the EC2 instance
#   pde-frontend/     React/Vite app built with `npm ci && npm run build`
# Dev/local-only files (tests, docker-compose, Helm/K8s, CI workflows,
# docs) are intentionally absent from this branch.
# ================================================================

# ---- Secrets: never commit real env files, keep the template ----
.env
.env.*
!.env.example

# ---- Python (backend) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
.vite/
coverage/
.eslintcache
.parcel-cache/
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Terraform local state (never commit real state) ----
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json

# ---- Runtime / uploads ----
pde-backend/uploads/

# ---- Local-only files (exist on the author's machine, never pushed) ----
# These live alongside the branch in the shared working tree but are not
# part of the production branch.
/DEPLOYMENT.md
/SECURITY.md
/monorepo.md
/kubernetes.md
/cmd-k8s.md
/REUSABLE_PROJECT_PROMPT.md
/GAP_ANALYSIS_AND_IMPLEMENTATION.md
/iSarita_PDE_Manual_Extract_for_Antigravity.md
/iSaritaPublicDataEntry_UserManual.pdf
*.zip
/pde-documentation/
.netlify/
# Real CloudFormation parameters with secrets (aws/ itself is not in prod)
aws/parameters/dev.json

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.sw?
