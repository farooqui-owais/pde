# ================================================================
# Root .gitignore — used if this becomes a single monorepo repo.
# The frontend also has its own .gitignore (pde-frontend/.gitignore)
# because it is pushed to GitHub as a standalone repo.
# ================================================================

# ---- Python (backend) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- environment files: NEVER commit real secrets, keep templates ---
.env
.env.*
!.env.example
.envrc
.flaskenv

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.vite/
.eslintcache
.parcel-cache/

# ---- Deploy / build artifacts ----
*.tar.gz
*.zip

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.sw?

# ---- Terraform / CloudFormation local state (never commit real state) ----
.terraform/
*.tfstate
*.tfstate.*

# ---- CloudFormation parameter files: real secrets, keep local ----
# Copy aws/parameters/dev.json.example -> aws/parameters/dev.json and fill in.
aws/parameters/dev.json

# ---- Root-level docs/artifacts kept local only (not pushed to GitHub) ----
# These are intentionally NOT tracked; they exist on disk locally.
/DEPLOYMENT.md
/SECURITY.md
/monorepo.md
/kubernetes.md
/REUSABLE_PROJECT_PROMPT.md
/iSarita_PDE_Manual_Extract_for_Antigravity.md
/iSaritaPublicDataEntry_UserManual.pdf

# ---- Docker / Kubernetes artifacts (NOT needed for the plain deploy) ----
# The recommended, simplest deployment is `deploy/deploy-plain.sh`
# (plain services: PostgreSQL + FastAPI/gunicorn + nginx; no Docker/K8s).
# These files are kept only as reference on disk; they are untracked.
/docker-compose.yml
/k8s/
/pde-backend/Dockerfile
/pde-backend/.dockerignore
/pde-backend/docker.md
/pde-frontend/Dockerfile
/pde-frontend/.dockerignore
/pde-backend/app/database.local.py
pde-antigravity-documentation