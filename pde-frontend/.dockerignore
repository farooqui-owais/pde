# pde-frontend — Docker build context ignores
# Excludes deps, build output and secrets from the image build context.

# Secrets
.env
.env.*
!.env.example

# Deps + build output
node_modules/
dist/
dist-ssr/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Git / editor noise
.git/
.gitignore
.idea/
.vscode/
