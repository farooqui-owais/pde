// =============================================================================
// PDE — local Kubernetes + GitOps pipeline  (kind + local registry + ArgoCD)
//
// OVERVIEW
// --------
// This pipeline is SEPARATE from on-premise/ci-cd/Jenkinsfile, which deploys
// via systemd/docker-compose. This one drives the local k8s GitOps flow:
//
//   1. Quality Gates  — backend (Python 3.11 venv + ruff + pytest)
//                       frontend (npm ci + lint + build)
//   2. Build & Push   — docker build both images, push to local registry
//   3. Bump tags      — sed-edit helm/pde/values-local.yaml with new image tags
//   4. Git push       — commit + push the values change back to the repo
//
// Jenkins never calls helm upgrade or kubectl apply for the application itself.
// ArgoCD (watching the deploy/local branch) detects the bump commit and syncs
// the cluster — that handoff is the actual "GitOps" boundary.
//
// PREREQUISITES (see local-k8s/README.md for the full walkthrough)
// ----------------------------------------------------------------
//  • Jenkins container started with:
//      --network kind
//      -v //var/run/docker.sock://var/run/docker.sock   (Windows/Docker Desktop)
//      -v /var/run/docker.sock:/var/run/docker.sock     (Linux / macOS)
//      --group-add 0   (Docker Desktop: socket owned root:root)
//  • Jenkins credential ID "git-creds" (Username with password):
//      Username : your GitHub username
//      Password : GitHub Personal Access Token with repo push scope
//  • Pipeline job configured to check out this repo,
//    Script Path: local-k8s/Jenkinsfile.k8s
// =============================================================================

pipeline {
    agent any

    environment {
        REGISTRY    = "localhost:5000"
        // Tag format: <build-number>-<git-short-sha>  e.g. "42-a1b2c3d"
        // Falls back to "local" if GIT_COMMIT is unavailable (manual trigger
        // without a full SCM checkout).
        IMAGE_TAG   = "${env.BUILD_NUMBER}-${env.GIT_COMMIT?.take(7) ?: 'local'}"
        // IMPORTANT: keep this as the HTTPS URL (no embedded credentials).
        // The "Bump & Push" stage constructs an authenticated URL at runtime
        // using the git-creds credential so the token never appears in the
        // Jenkinsfile or in build logs.
        GIT_REPO_URL        = "https://github.com/farooqui-owais/pde.git"
        GIT_CREDENTIALS_ID  = "git-creds"
    }

    triggers {
        // Poll GitHub every ~5 minutes (H = jittered minute, spread the load
        // across Jenkins instances). This makes the pipeline start on its own
        // after a merge to main, no manual "Build Now" and no GitHub webhook
        // needed. A webhook to http://<jenkins>:8080/github-webhook/ is the
        // zero-latency alternative — pollSCM stays as the fallback either way.
        // Bump commits pushed by this pipeline go to the deploy/local branch,
        // which this job does not build (Branches: */main), so no feedback loop.
        pollSCM('H/5 * * * *')
    }

    stages {

        // ---------------------------------------------------------------
        // Stage 1 — Checkout
        // ---------------------------------------------------------------
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ---------------------------------------------------------------
        // Stage 2 — Backend Quality Gate
        //
        // Runs inside the official python:3.11-slim image (same base as
        // pde-backend/Dockerfile) to guarantee version parity with prod.
        //
        // Jenkins may store its workspace in a Docker named volume. A sibling
        // container cannot bind-mount that container-local path from the host.
        // Copy the source through the Docker API into an isolated test container;
        // this also works with host-based Jenkins agents and remote daemons.
        //
        // Steps inside the container:
        //   • python3 -m venv  → isolated, clean environment
        //   • pip install       → all prod + dev dependencies
        //   • ruff check        → linting (PEP 8 / style enforcement)
        //   • pytest            → unit tests with coverage report
        // ---------------------------------------------------------------
        stage('Backend Quality Gate') {
            steps {
                sh '''
                    set -eu
                    test -f pde-backend/requirements-dev.txt
                    test_container=''
                    cleanup() {
                        if [ -n "$test_container" ]; then
                            docker rm -f "$test_container" >/dev/null 2>&1 || true
                        fi
                    }
                    trap cleanup EXIT
                    trap 'exit 1' HUP INT TERM
                    test_container=$(docker create \
                        -w /app \
                        -e DATABASE_URL="sqlite:///:memory:" \
                        -e DEBUG="True" \
                        -e SECRET_KEY="ci-test-secret-key-32-chars-long!" \
                        python:3.11-slim \
                        sh -ec "
                            python3 -m venv /tmp/pde-ci-venv
                            . /tmp/pde-ci-venv/bin/activate
                            python -m pip install --quiet --upgrade pip
                            python -m pip install --quiet -r requirements-dev.txt
                            echo '--- ruff lint ---'
                            ruff check app/
                            echo '--- pytest ---'
                            pytest tests/ --cov=app --cov-report=term-missing -v
                        ")
                    docker cp pde-backend/. "$test_container:/app"
                    docker start -a "$test_container"
                    test_exit=$(docker inspect --format '{{.State.ExitCode}}' "$test_container")
                    exit "$test_exit"
                '''
            }
        }

        // ---------------------------------------------------------------
        // Stage 3 — Frontend Quality Gate
        //
        // npm ci  : clean, reproducible install from package-lock.json
        // lint    : || true is intentional for local practice — remove
        //           the '|| true' in a production pipeline to break on
        //           lint failures.
        // build   : Vite production bundle (validates the build succeeds)
        // ---------------------------------------------------------------
        stage('Frontend Quality Gate') {
            steps {
                dir('pde-frontend') {
                    sh '''
                        npm ci
                        npm run lint || true
                        npm run build
                    '''
                }
            }
        }

        // ---------------------------------------------------------------
        // Stage 4 — Build & Push Images
        //
        // Builds both images and pushes to the local kind registry
        // (localhost:5000). The registry is reachable from the Jenkins
        // container because both are on the "kind" Docker network.
        // ---------------------------------------------------------------
        stage('Build & Push Images') {
            steps {
                sh """
                    docker build \
                        -t ${REGISTRY}/pde/backend:${IMAGE_TAG} \
                        pde-backend

                    docker push ${REGISTRY}/pde/backend:${IMAGE_TAG}

                    docker build \
                        -f pde-frontend/Dockerfile.prod \
                        -t ${REGISTRY}/pde/frontend:${IMAGE_TAG} \
                        pde-frontend

                    docker push ${REGISTRY}/pde/frontend:${IMAGE_TAG}
                """
            }
        }

        // ---------------------------------------------------------------
        // Stage 5 — Bump Image Tags for ArgoCD
        //
        // Edits the two `tag:` values inside helm/pde/values-local.yaml
        // and pushes the change back to the repo. ArgoCD polls the repo
        // every ~3 minutes and syncs automatically on detecting the change.
        //
        // sed note: we anchor each replacement to the line immediately
        // following its parent key (`repository:`) using two-pass sed so
        // we never accidentally replace a `tag:` key in another section
        // (e.g. targetRevision, chart tags, etc.).
        //
        // git push note: credentials are injected into the remote URL at
        // runtime via withCredentials — the token never appears in logs
        // because Jenkins masks ${GIT_TOKEN} automatically.
        // [skip ci] in the commit message prevents ArgoCD / any webhook
        // from triggering a new build loop on this bump commit.
        // ---------------------------------------------------------------
        stage('Bump Image Tags for ArgoCD') {
            steps {
                dir('helm/pde') {
                    sh """
                        # Replace tag under backend.image block (line after `repository: .*/backend`)
                        sed -i '/repository:.*\\/pde\\/backend/{n; s|^\\(\\s*tag:\\).*|\\1 ${IMAGE_TAG}|}' values-local.yaml

                        # Replace tag under frontend.image block (line after `repository: .*/frontend`)
                        sed -i '/repository:.*\\/pde\\/frontend/{n; s|^\\(\\s*tag:\\).*|\\1 ${IMAGE_TAG}|}' values-local.yaml

                        echo "Updated values-local.yaml:"
                        grep -A2 'repository:' values-local.yaml
                    """
                }

                sh """
                    git config user.email 'jenkins@pde.local'
                    git config user.name  'jenkins-ci'
                    git add helm/pde/values-local.yaml
                    git commit -m "ci: bump PDE image tags to ${IMAGE_TAG} [skip ci]" \
                        || echo "Nothing to commit — tag unchanged"
                """

                // Inject credentials into the push URL at runtime.
                // GIT_TOKEN is masked in logs by Jenkins credentials binding.
                withCredentials([usernamePassword(
                    credentialsId: "${GIT_CREDENTIALS_ID}",
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh """
                        AUTHENTICATED_URL=\$(echo "${GIT_REPO_URL}" | sed "s|https://|https://\${GIT_USER}:\${GIT_TOKEN}@|")

                        // Push to the automation-only environment branch, NOT main.
                        // deploy/local is a disposable "pointer" branch: it is
                        // force-updated on every build to (main HEAD + bump commit).
                        // ArgoCD's local app (targetRevision: deploy/local) watches
                        // only this branch — bump commits never touch main, so
                        // GitHub Actions CI is never re-triggered by them.
                        // --force is required: main HEAD + bump is not a
                        // fast-forward of the previous deploy/local tip.
                        git push --force "\${AUTHENTICATED_URL}" HEAD:deploy/local
                    """
                }
            }
        }
    }

    post {
        success {
            echo """
╔══════════════════════════════════════════════════════════════════╗
║  BUILD SUCCESS                                                    ║
║  Pushed: ${REGISTRY}/pde/backend:${IMAGE_TAG}                    ║
║  Pushed: ${REGISTRY}/pde/frontend:${IMAGE_TAG}                   ║
║  Updated: helm/pde/values-local.yaml                             ║
║  ArgoCD will sync within ~3 minutes automatically.               ║
╚══════════════════════════════════════════════════════════════════╝
            """
            // Clean workspace only on success — on failure the workspace is
            // preserved so you can inspect build artifacts and logs.
            cleanWs()
        }
        failure {
            echo """
╔══════════════════════════════════════════════════════════════════╗
║  BUILD FAILED — workspace preserved for debugging.               ║
║  Check the stage logs above for the exact error.                 ║
║  Common causes:                                                  ║
║    • Backend Quality Gate: ruff lint errors or failing tests     ║
║    • Build & Push: registry not reachable (localhost:5000)       ║
║    • Bump & Push: git-creds token expired or wrong scope         ║
╚══════════════════════════════════════════════════════════════════╝
            """
        }
    }
}
