# =============================================================================
# DakhalNama / PDE — On-Premise Environment Configuration
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
APP_NAME="DakhalNama PDE Portal"
APP_VERSION="1.0.0"
# Set DEBUG to False in production (disables interactive docs in prod if desired)
DEBUG=False

# Fully Qualified Domain Name or Server IP (e.g. pde.local, pde.internal.gov.in, or 192.168.1.50)
DOMAIN_NAME=localhost

# Ports exposed on host
HTTP_PORT=80
HTTPS_PORT=443

# External port mapping for PostgreSQL (set to empty or 127.0.0.1:5432 for security)
DB_EXTERNAL_PORT=127.0.0.1:5432

# -----------------------------------------------------------------------------
# Security & Auth Keys
# -----------------------------------------------------------------------------
# CRITICAL: Generate a strong secret key (minimum 32 random characters)
# Linux: openssl rand -base64 48
SECRET_KEY=replace-with-a-very-secure-random-string-at-least-32-chars-long!

ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# Allowed CORS Origins (comma-separated). When accessed via central proxy, same-origin applies
CORS_ORIGINS=http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1

# Set CSRF_COOKIE_SECURE to True if serving over HTTPS
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Trusted hostnames (Host header protection)
TRUSTED_HOSTS=localhost,127.0.0.1

# Per-IP Rate Limiting (attempts per window)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# PostgreSQL Database Settings
# -----------------------------------------------------------------------------
POSTGRES_DB=dakhalnama
POSTGRES_USER=dakhal_user
POSTGRES_PASSWORD=replace-with-a-secure-database-password-2026

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
